# ==============================================================================
# VICTORIA LAR RESIDENCIAL — VARIÁVEIS DE AMBIENTE PARA VERCEL & PRODUÇÃO
# ==============================================================================
# Este arquivo lista todas as variáveis de ambiente necessárias para a execução
# da aplicação na Vercel e em contêineres locais.
# NUNCA insira chaves privadas reais ou senhas neste arquivo ou em arquivos versionados.

# ------------------------------------------------------------------------------
# 1. CONFIGURAÇÃO PÚBLICA DO FIREBASE WEB SDK (CLIENTE - NAVEGADOR)
# ------------------------------------------------------------------------------
# Disponíveis no navegador via import.meta.env (prefixo VITE_ obrigatório).
# Obtenha em: Firebase Console > Configurações do Projeto > Geral > Seus aplicativos (Web)

# VITE_FIREBASE_PROJECT_ID: ID do projeto Firebase oficial (padrão: "victoria-lar-residencial")
VITE_FIREBASE_PROJECT_ID="victoria-lar-residencial"

# VITE_FIREBASE_DATABASE_ID: Banco de dados Cloud Firestore (padrão oficial: "(default)")
VITE_FIREBASE_DATABASE_ID="(default)"

# VITE_FIREBASE_API_KEY: Web API Key gerada pelo Firebase/Google Cloud
VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# VITE_FIREBASE_AUTH_DOMAIN: Domínio de autenticação do Firebase Auth
VITE_FIREBASE_AUTH_DOMAIN="victoria-lar-residencial.firebaseapp.com"

# VITE_FIREBASE_STORAGE_BUCKET: Bucket do Firebase Storage para fotos e documentos
VITE_FIREBASE_STORAGE_BUCKET="victoria-lar-residencial.firebasestorage.app"

# VITE_FIREBASE_MESSAGING_SENDER_ID: Número do projeto / ID do remetente FCM
VITE_FIREBASE_MESSAGING_SENDER_ID="256370289094"

# VITE_FIREBASE_APP_ID: ID do aplicativo web registrado no Firebase
VITE_FIREBASE_APP_ID="1:256370289094:web:fcbd36c3e6a78580c3eac7"

# VITE_FIREBASE_MEASUREMENT_ID: (Opcional) ID de fluxo do Google Analytics (ex: "G-XXXXXXXXXX")
VITE_FIREBASE_MEASUREMENT_ID=""


# ------------------------------------------------------------------------------
# 2. CREDENCIAIS EXCLUSIVAS DO FIREBASE ADMIN SDK (SERVIDOR / SERVERLESS)
# ------------------------------------------------------------------------------
# ATENÇÃO CRÍTICA DE SEGURANÇA:
# NUNCA use o prefixo VITE_ nestas variáveis! Elas contêm permissões administrativas
# e devem ser lidas exclusivamente pelas funções serverless do backend (/api/*).
#
# Como gerar a chave de serviço no Firebase Console:
# 1. Acesse https://console.firebase.google.com/project/victoria-lar-residencial/settings/serviceaccounts/adminsdk
# 2. Clique em "Gerar nova chave privada". Um arquivo JSON será baixado.
# 3. Na Vercel (Project Settings > Environment Variables):
#    - Adicione a variável FIREBASE_SERVICE_ACCOUNT_KEY
#    - Cole o conteúdo JSON completo da chave (como string JSON em uma única linha ou codificado em Base64).
#    - Marque os ambientes "Production" e "Preview".

# FIREBASE_PROJECT_ID: ID do projeto para o Admin SDK no servidor
FIREBASE_PROJECT_ID="victoria-lar-residencial"

# FIREBASE_DATABASE_ID: Banco Firestore padrão para o servidor
FIREBASE_DATABASE_ID="(default)"

# FIREBASE_SERVICE_ACCOUNT_KEY: Conteúdo JSON da Chave Privada da Conta de Serviço (Service Account)
# Exemplo: {"type":"service_account","project_id":"victoria-lar-residencial","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@victoria-lar-residencial.iam.gserviceaccount.com"}
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"victoria-lar-residencial","private_key":"...","client_email":"..."}'


# ------------------------------------------------------------------------------
# 3. CONFIGURAÇÕES DE ENVIO DE E-MAIL (SMTP / GMAIL / PROVEDOR TRANSACIONAL)
# ------------------------------------------------------------------------------
# Utilizado pelas funções serverless para enviar confirmação de agendamento de
# reuniões online (Google Meet) e confirmação de contato institucional.

# GMAIL_USER: E-mail remetente oficial da Victoria Lar Residencial
GMAIL_USER="victorialarresidencial@gmail.com"

# OPÇÃO A — Gmail Direto (Requer Senha de App Google):
# Gere em: https://myaccount.google.com/apppasswords
# (Requer autenticação em duas etapas ativada na conta Google).
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# OPÇÃO B — Servidor SMTP Genérico / Provedor Transacional (SendGrid, Brevo, Resend, etc.):
# SMTP_HOST: Endereço do servidor SMTP (ex: smtp.gmail.com, smtp.resend.com, smtp-relay.brevo.com)
SMTP_HOST="smtp.gmail.com"

# SMTP_PORT: Porta de conexão SMTP.
# ATENÇÃO NA VERCEL:
# - Porta 465 (Recomendada para Gmail): TLS implícito (requer SMTP_SECURE="true").
# - Porta 587: STARTTLS (requer SMTP_SECURE="false"). Se definir secure=true em 587, causará ETIMEDOUT!
# - Porta 25: BLOQUEADA na Vercel e AWS Lambda para prevenção de spam. Não use porta 25.
SMTP_PORT="465"

# SMTP_SECURE: "true" para porta 465 (SSL/TLS implícito); "false" para porta 587 (STARTTLS).
SMTP_SECURE="true"

# SMTP_USER: Usuário de autenticação SMTP
SMTP_USER="victorialarresidencial@gmail.com"

# SMTP_PASS: Senha de aplicativo ou chave de API SMTP
SMTP_PASS="xxxx xxxx xxxx xxxx"

# LIMITES DE TEMPO SMTP PARA FUNÇÕES SERVERLESS (em milissegundos):
# Ajustados para evitar travamento da função serverless na Vercel.
SMTP_CONNECTION_TIMEOUT="5000"
SMTP_GREETING_TIMEOUT="5000"
SMTP_SOCKET_TIMEOUT="8000"


# ------------------------------------------------------------------------------
# 4. CONFIGURAÇÕES DE URLS E SERVIÇOS EXTERNOS
# ------------------------------------------------------------------------------

# APP_URL: URL canônica da aplicação implantada (ex: "https://victoria-lar-residencial.vercel.app")
APP_URL="https://seu-dominio-ou-app.vercel.app"

# GEMINI_API_KEY: (Opcional, quando aplicável) Chave de API Gemini
GEMINI_API_KEY=""
